{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [
        { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/backlog-guard.sh\"", "timeout": 10 }
      ]}
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/backlog-autosync.sh\"", "timeout": 60 }
      ]}
    ]
  }
}
